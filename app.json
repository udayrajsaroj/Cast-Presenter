{
  "expo": {
    "name": "Cast Presenter",
    "slug": "cast-presenter",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to the local cast server on your Wi-Fi network."
      }
    },
    "android": {
      "config": {
        "usesCleartextTraffic": true
      },
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.udayraj_saroj.castpresenter"
    },
    "plugins": [
      "expo-document-picker",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "570b9155-f9f7-4bf0-9fc8-797d3d1654a2"
      }
    }
  }
}
